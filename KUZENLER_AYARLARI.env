# ---------------------- CANLI GÜVENLİK --------------------------------
# Canlı modda sistem bunları zorunlu uygular.
REQUIRE_AUTH_IN_LIVE=true
ALLOW_ANONYMOUS_PLAY=false
ALLOW_PUBLIC_SIGNUP=true
ENABLE_PARENT_ACCOUNTS=true
ENABLE_TEACHER_ACCOUNTS=true
ENABLE_STUDENT_ACCOUNTS=true
ENABLE_TEACHER_BULK_IMPORT=true
ENABLE_PARENT_ANALYTICS=true
ENABLE_TEACHER_ANALYTICS=true
ENABLE_PWA=true

# Öğrenci kodundan Firebase Auth e-postası üretmek için teknik alan.
# Gerçek e-posta gönderilmez.
