# =====================================================================
# ZİHİN ARENASI 13.8 - TEK AYAR DOSYASI
#
# SADECE AŞAĞIDAKİ TEK SATIRI DEĞİŞTİRİN:
#   Bilgisayarda test: CALISMA_MODU=canli
#   GitHub/Vercel canlı: CALISMA_MODU=canli
#
# Diğer GitHub ve Firebase bağlantıları hazırdır.
# Parola, Firebase service-account/private-key, GitHub tokenı veya
# Vercel tokenı bu dosyaya YAZILMAZ.
# =====================================================================

CALISMA_MODU=canli

APP_NAME=Zihin Arenası
APP_SHORT_NAME=Zihin
APP_DESCRIPTION=1-12. sınıf kapsamını hedefleyen; yalnız insan incelemesinden geçmiş whitelist içeriklerini canlıda açan öğrenme ve zekâ platformu.
LOCAL_PORT=6220
CONTENT_VERSION=13.8.0-trusted-live-hard-core

# -------------------------- GIT ---------------------------------------
GIT_REPOSITORY_URL=MEVCUT_AYAR_DOSYANIZI_KORUYUN
GIT_DEFAULT_BRANCH=main
GIT_USER_NAME=İbrahim YOKUŞ
GIT_USER_EMAIL=MEVCUT_AYAR_DOSYANIZI_KORUYUN

# ------------------------- VERCEL -------------------------------------
VERCEL_PROJECT_NAME=kuzenler-yarisiyor
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# ------------------------ FIREBASE ------------------------------------
# Firebase Web istemci yapılandırması. Bu değerler web uygulamalarında
# istemciye gönderilir; veri güvenliğini Firestore Rules sağlar.
FIREBASE_API_KEY=MEVCUT_AYAR_DOSYANIZI_KORUYUN
FIREBASE_AUTH_DOMAIN=kuzenleryarisiyor.firebaseapp.com
FIREBASE_PROJECT_ID=kuzenleryarisiyor
FIREBASE_STORAGE_BUCKET=kuzenleryarisiyor.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=MEVCUT_AYAR_DOSYANIZI_KORUYUN
FIREBASE_APP_ID=MEVCUT_AYAR_DOSYANIZI_KORUYUN
FIREBASE_MEASUREMENT_ID=MEVCUT_AYAR_DOSYANIZI_KORUYUN

# ---------------------- CANLI GÜVENLİK --------------------------------
# Canlı modda sistem bunları zorunlu uygular.
REQUIRE_AUTH_IN_LIVE=true
ALLOW_ANONYMOUS_PLAY=false
ALLOW_PUBLIC_SIGNUP=true
ENABLE_PARENT_ACCOUNTS=true
ENABLE_TEACHER_ACCOUNTS=true
ENABLE_STUDENT_ACCOUNTS=true
ENABLE_TEACHER_BULK_IMPORT=true
ENABLE_PARENT_ANALYTICS=true
ENABLE_TEACHER_ANALYTICS=true
ENABLE_PWA=true
QUALITY_PILOT_MODE=false
CONTROLLED_LAUNCH_PILOT_MODE=true
CONTROLLED_LAUNCH_PILOT_VERSION=PHASE5I_PILOT_1

# Öğrenci kodundan Firebase Auth e-postası üretmek için teknik alan.
# Gerçek e-posta gönderilmez.
STUDENT_AUTH_DOMAIN=students.kuzenleryarisiyor.local

# Pilot sınırları
MAX_CHILDREN_PER_PARENT=8
MAX_STUDENTS_PER_CLASSROOM=50
MAX_BULK_IMPORT=40

# İlk sistem yöneticisi hesabı
OWNER_ADMIN_EMAIL=MEVCUT_AYAR_DOSYANIZI_KORUYUN
AI_PROVIDER=local
